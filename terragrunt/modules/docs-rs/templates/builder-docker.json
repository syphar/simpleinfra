{
  "storage-driver": "overlay2",
  "exec-opts": ["native.cgroupdriver=cgroupfs"],
  "runtimes": {
    "runsc": {
      "path": "/usr/bin/runsc",
      "runtimeArgs": [
        "--platform=systrap",
        "--debug-log=/var/log/runsc/%TIMESTAMP%.%ID%.%COMMAND%.jsonl",
        "--debug-log-format=json",
        "--panic-log=/var/log/runsc/%TIMESTAMP%.%ID%.%COMMAND%.panic.log"
      ]
    }
  },
  "log-driver": "local",
  "log-opts": {"max-size": "20m", "max-file": "3"}
}
