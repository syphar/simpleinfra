# {{ ansible_managed }}
ECS_CLUSTER={{ vars_ecs_cluster }}
ECS_INSTANCE_ATTRIBUTES={{ {'docsrs-builder': vars_builder_name} | to_json }}
ECS_ENABLE_TASK_IAM_ROLE=true
ECS_ENABLE_AWSLOGS_EXECUTIONROLE_OVERRIDE=true
# The named-host placement constraint prevents binpacking more builders here.
# Rustwide enforces limits on sibling build containers, outside ECS accounting.
ECS_ENABLE_TASK_CPU_MEM_LIMIT=false
ECS_RESERVED_MEMORY=512
ECS_AVAILABLE_LOGGING_DRIVERS=["json-file","awslogs"]
