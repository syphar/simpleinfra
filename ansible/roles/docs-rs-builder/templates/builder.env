# {{ ansible_managed }}
{% set defaults = {
  'DOCSRS_PREFIX': vars_prefix_path,
  'DOCSRS_RUSTWIDE_WORKSPACE': vars_workspace_path,
  'DOCSRS_DOCKER': 'true',
  'DOCSRS_DOCKER_RUNTIME': 'runsc',
  'DOCSRS_TOOLCHAIN': vars_toolchain,
  'DOCSRS_STORAGE_BACKEND': 's3',
  'DOCSRS_S3_BUCKET': vars_s3_bucket,
  'S3_REGION': vars_aws_region,
  'AWS_REGION': vars_aws_region,
  'DOCSRS_LOG': 'info,rustwide=info',
  'DOCSRS_LOG_FORMAT': 'json',
  'RUST_BACKTRACE': '1',
  'DOCSRS_MIN_POOL_IDLE': '1',
  'DOCSRS_MAX_POOL_SIZE': '4',
  'DOCSRS_LOG_BUILD_LOGS': 'false',
  'DOCSRS_AWS_SDK_MAX_RETRIES': '10',
  'DOCSRS_INCLUDE_DEFAULT_TARGETS': 'false',
  'DOCSRS_BUILD_CPU_LIMIT': vars_build_cpu_limit | string,
  'DOCSRS_BUILD_DEFAULT_MEMORY_LIMIT': vars_build_memory_limit | string,
  'DOCSRS_BUILD_WORKSPACE_REINITIALIZATION_INTERVAL': '2h'
} %}
{% for name, value in (defaults | combine(vars_builder_environment)).items() %}
{{ name }}={{ value }}
{% endfor %}
