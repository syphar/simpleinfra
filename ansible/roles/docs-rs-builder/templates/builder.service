# {{ ansible_managed }}
[Unit]
Description=The docs.rs Builder
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
RuntimeDirectory=docs-rs-builder
RuntimeDirectoryMode=0700
ExecStartPre=/usr/local/sbin/docs-rs-builder prepare
ExecStart=/usr/local/sbin/docs-rs-builder run
ExecStop=/usr/bin/docker stop --time {{ vars_builder_stop_timeout }} docs-rs-builder
Restart=on-failure
RestartSec=30
TimeoutStartSec=900
TimeoutStopSec={{ vars_builder_stop_timeout + 30 }}

[Install]
WantedBy=multi-user.target
